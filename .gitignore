###############################
# Python / Build Artifacts
###############################
__pycache__/
*.pyc
*.pyo

###############################
# Virtual Environments
###############################
.env/
.venv/
env/
venv/

###############################
# VSCode
###############################
.vscode/

###############################
# Jupyter Notebooks
###############################
.ipynb_checkpoints/

###############################
# Data (DO NOT TRACK BIG FILES)
###############################
# Ignore raw datasets (BraTS MRI files, 4GB+)
data/raw/

# Ignore generated intermediate data
data/processed/

# Ignore autogenerated split files EXCEPT CSVs we want to keep
data/splits/
!data/splits/*.csv   # allow CSV split metadata to be committed

###############################
# Model Weights / Checkpoints
###############################
*.pth
*.pt
*.ckpt
*.joblib

###############################
# Training / Inference Outputs
###############################
outputs/
runs/

###############################
# Logs
###############################
logs/
*.log
